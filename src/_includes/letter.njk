<section class="letter wrap" id="letter">
  <div class="label" style="color:var(--laterite)">The Veranda Letter</div>
  <h3>New essays, once or twice a month</h3>
  <p>Get each new piece by email. No noise, just the next conversation from the veranda.</p>
  <form class="signup" name="letter" method="POST" action="/thanks/" data-netlify="true" netlify-honeypot="company">
    <input type="hidden" name="form-name" value="letter">
    <p class="hp"><label>Leave this empty <input name="company"></label></p>
    <label for="email" class="skip">Email address</label>
    <input id="email" name="email" type="email" required placeholder="Your email address" autocomplete="email">
    <button type="submit" class="label">Subscribe</button>
  </form>
</section>
